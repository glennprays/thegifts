{
  "name": "kaskur",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "postinstall": "node scripts/patch-satori.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "deploy": "wrangler deploy",
    "preview:cloudflare": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply thegifts --local",
    "db:migrate:remote": "wrangler d1 migrations apply thegifts --remote",
    "predev": "npm run db:migrate:local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.36.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.36.0",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.1.16",
    "dotenv": "^17.2.3",
    "nanoid": "^5.1.6",
    "qrcode": "^1.5.4",
    "resvg-wasm-loader": "file:vendor/resvg-wasm-loader",
    "satori": "^0.25.0",
    "svelte-i18n": "^4.0.1",
    "svelte-meta-tags": "^4.5.0",
    "tailwindcss": "^4.1.16",
    "yoga-wasm-loader": "file:vendor/yoga-wasm-loader"
  }
}